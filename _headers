# Static caching for Cloudflare Pages. HTML retains the platform default revalidation.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/optimized/*
  Cache-Control: public, max-age=3600, must-revalidate
/fonts.css
  Cache-Control: public, max-age=3600, must-revalidate

/styles.css
  Cache-Control: public, max-age=3600, must-revalidate
/mix.css
  Cache-Control: public, max-age=3600, must-revalidate
/tirana.css
  Cache-Control: public, max-age=3600, must-revalidate
/script.js
  Cache-Control: public, max-age=3600, must-revalidate
/site-content.js
  Cache-Control: public, max-age=3600, must-revalidate
